# Copie para .env (o .env nunca vai para o git: RN-04).
# UID/GID do seu usuário no WSL (rode `id -u` e `id -g`).
USER_UID=1000
USER_GID=1000

# Servidor MCP da Obsidian CLI rodando no Windows (`obsidian-cli-mcp.js --http`, só em
# 127.0.0.1). Com o WSL em `networkingMode=mirrored` e o contêiner na rede do WSL
# (`network_mode: host`), o endereço é o mesmo no Windows, no WSL e no contêiner.
OBSIDIAN_MCP_URL=http://127.0.0.1:27180/mcp
# Cofre do projeto no Obsidian que a integração checa, até o projeto ter o cofre de
# memória dele (ENT-02).
MYHARNESS_OBSIDIAN_COFRE=myHarness-vault

# client_id do app OAuth do MyHarness no GitHub (device flow, RF-03). É público: o device
# flow não usa client secret. O token do Humano vai para o Gerenciador de Credenciais do
# Windows, nunca para este arquivo (RNF-05).
MYHARNESS_GITHUB_CLIENT_ID=Ov23li904l2z5LWigHyr
