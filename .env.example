# Copie para .env (o .env nunca vai para o git: RN-04).
# UID/GID do seu usuário no WSL (rode `id -u` e `id -g`).
USER_UID=1000
USER_GID=1000

# Servidor MCP da Obsidian CLI rodando no Windows (transporte HTTP). Porta: [a confirmar].
OBSIDIAN_MCP_URL=http://host.docker.internal:3901/mcp

# client_id do app OAuth do MyHarness no GitHub (device flow, RF-03). É público: o device
# flow não usa client secret. O token do Humano vai para o Gerenciador de Credenciais do
# Windows, nunca para este arquivo (RNF-05).
MYHARNESS_GITHUB_CLIENT_ID=Ov23li904l2z5LWigHyr
